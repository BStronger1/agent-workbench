le.cursor = 'pointer';\n                    primaryBtn.textContent = '完成一项任务';\n                }\n            }\n\n            function handleComplete() {\n                if (completed < MAX) {\n                    completed++;\n                    updateUI();\n                }\n            }\n\n            primaryBtn.addEventListener('click', handleComplete);\n\n            // 初始渲染\n            updateUI();\n        })();\n    </script>\n</body>\n</html>",
