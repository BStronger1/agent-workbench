        overflow: hidden;\n            margin: 16px 0 8px;\n        }\n        .progress-bar-fill {\n            height: 100%;\n            width: 0%;\n            background: linear-gradient(90deg, #3182ce, #63b3ed);\n            border-radius: 12px;\n            transition: width 0.3s ease;\n        }\n        .progress-text {\n            font-size: 14px;\n            color: #718096;\n        }\n        .btn {\n            background: #3182ce;\n            color: white;\n            border: none;\n            border-radius: 40px;\n            padding: 14px 40px;\n            font-size: 18px;\n            font-weight: 600;\n            cursor: pointer;\n            transition: background 0.2s, transform 0.1s;\n            box-shadow: 0 4px 12px rgba(49,130,206,0.3);\n            letter-spacing: 1px;\n        }\n        .btn:hover {\n            background: #2b6cb0;\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px rgba(49,130,206,0.35);\n        }\n        .btn:active {\n            transform: translateY(0);\n            box-shadow: 0 2px 8px rgba(49,130,206,0.25);\n        }\n        .btn:focus-visible {\n            outline: 3px solid #90cdf4;\n            outline-offset: 2px;\n        }\n        .result-area {\n            margin-top: 24px;\n            padding: 16px;\n            background: #edf2f7;\n            border-radius: 12px;\n            font-size: 16px;\n            color: #2d3748;\n            min-height: 56px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            gap: 6px;\n            flex-wrap: wrap;\n        }\n        .result-area span {\n            font-weight: 600;\n            color: #2b6cb0;\n        }\n        .footer-note {\n            margin-top: 20px;\n            font-size: 13px;\n            color: #a0aec0;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"card\">\n        <h1>研究任务</h1>\n        <div class=\"subtitle\">项目进度 · 持续跟踪</div>\