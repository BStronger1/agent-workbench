m: scale(0.98);\n        }\n        button:active {\n            background: #020617;\n        }\n        .footer-note {\n            margin-top: 1.2rem;\n            font-size: 0.8rem;\n            color: #94a3b8;\n            text-align: right;\n        }\n        .highlight {\n            background: #eef2ff;\n            border-color: #a5b4fc;\n        }\n        /* 保证所有文本可见 */\n        .required-text {\n            display: inline;\n        }\n    </style>\n</head>\n<body>\n<div class=\"card\">\n    <!-- h1 包含“实验准备”和“项目进度”两个 requiredTexts -->\n    <h1>\n        <span class=\"required-text\">实验准备</span>\n        <small class=\"required-text\">项目进度</small>\n    </h1>\n    <div class=\"subhead\">🧪 勾选第一项，点击更新</div>\n\n    <!-- 清单列表：三个项目，只有第一个使用 data-testid=\"selection-item\" -->\n    <div class=\"list-container\">\n        <div class=\"list-item highlight\" data-testid=\"selection-item\">\n            <input type=\"checkbox\" id=\"item1\" data-testid=\"selection-item-checkbox\" aria-label=\"选择 试管与试剂\">\n            <label for=\"item1\">🔬 试管与试剂</label>\n        </div>\n        <div class=\"list-item\" data-testid=\"list-item-2\">\n            <input type=\"checkbox\" id=\"item2\" data-testid=\"checkbox-item2\" aria-label=\"选择 显微镜\">\n            <label for=\"item2\">🔭 显微镜</label>\n        </div>\n        <div class=\"list-item\" data-testid=\"list-item-3\">\n            <input type=\"checkbox\" id=\"item3\" data-testid=\"checkbox-item3\" aria-label=\"选择 防护手套\">\n            <label for=\"item3\">🧤 防护手套</label>\n        </div>\n    </div>\n\n    <!-- 操作区：更新按钮 + 结果 -->\n    <div class=\"action-area\">\n        <button data-testid=\"primary-action\" id=\"updateBtn\">⟳ 更新进度</button>\n        <div class=\"result-badge\" data-testid=\"result\" id=\"resultDisplay\">\n            <span id=\"resultCount\">0</span> 项已完成\n        </div>\n    </div>\n    <div class=\"footer-note\">✔ 勾选第一项后点击更新</div>\n</div>\n\n<script>\n    (function() {\n        // DOM 元素 —— 严格匹配 data-testid\n 