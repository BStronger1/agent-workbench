# Never commit .env. API keys stay on the server, never in web/.
WORKBENCH_MODE=demo
PORT=18123
BIND_ADDRESS=127.0.0.1
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# Required for the optional shared server model; personal browser configuration needs no shared token.
LIVE_ACCESS_TOKEN=
# Optional: replace the default comma-separated HTTPS provider hostname allowlist.
# PROVIDER_ALLOWED_HOSTS=api.deepseek.com,api.openai.com,dashscope.aliyuncs.com,api.siliconflow.cn
# Prices in your provider's billing currency per one million tokens; 0 = unavailable.
INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0
