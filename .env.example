# Never commit .env. API keys stay on the server, never in web/.
WORKBENCH_MODE=demo
PORT=18123
BIND_ADDRESS=127.0.0.1
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# Required for live generation: use a random string of at least 24 characters.
LIVE_ACCESS_TOKEN=
# Prices in your provider's billing currency per one million tokens; 0 = unavailable.
INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0
